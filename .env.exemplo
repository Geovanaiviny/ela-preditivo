# Opções do docker-compose.yml. Copie para .env (que não é versionado) e ajuste; tudo aqui é opcional.

# Endereço e porta publicados na máquina. 127.0.0.1 atende só esta máquina.
ELA_ENDERECO=127.0.0.1
ELA_PORTA=8000

# homologacao: selo de dados fictícios e demonstração oferecida na tela de primeiro acesso. producao: sem os dois.
ELA_WEB_AMBIENTE=homologacao

# Chave de cifra (Fernet). Vazia: criada na primeira subida e guardada no volume, em dados_web/chave.env.
ELA_WEB_CHAVE=

# Atrás de HTTPS, use 1 para o cookie de sessão só trafegar cifrado.
ELA_WEB_COOKIE_SEGURO=0

# Opcional: administrador criado já na subida, com senha temporária (trocada no primeiro login). Sem isto, o
# administrador é criado no navegador, na tela de primeiro acesso, por quem abrir o endereço primeiro.
ELA_ADMIN_NOME=
ELA_ADMIN_CPF=
ELA_ADMIN_EMAIL=
ELA_ADMIN_SENHA=

# Encarregado pelo tratamento de dados (LGPD, art. 41), mostrado em Privacidade e Ajuda.
ELA_ENCARREGADO_NOME=
ELA_ENCARREGADO_CONTATO=
